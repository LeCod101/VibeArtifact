# ── Database ──
DATABASE_URL=postgresql+asyncpg://vibe:vibe@localhost:5432/vibeartifact
DATABASE_URL_SYNC=postgresql://vibe:vibe@localhost:5432/vibeartifact

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── LLM（国产模型，四选一或组合配置） ──
# API Key（按需配置所用厂商）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=

# 推理型（intent/contraction/planner/schema 等决策任务）
# 示例组合：
#   REASONING_PROVIDER=deepseek    REASONING_MODEL=deepseek-chat
#   REASONING_PROVIDER=dashscope   REASONING_MODEL=qwen-max
#   REASONING_PROVIDER=moonshot    REASONING_MODEL=moonshot-v1-8k
#   REASONING_PROVIDER=minimax     REASONING_MODEL=MiniMax-M3
REASONING_PROVIDER=
REASONING_MODEL=

# 生成型（backend/frontend/doc/diagram/export 等内容生成任务）
GENERATION_PROVIDER=
GENERATION_MODEL=

# 可选：自定义 endpoint 覆盖（如接入其他 OpenAI 兼容国产网关）
# DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# MINIMAX_API_BASE=https://api.minimaxi.com/v1

# ── App ──
APP_ENV=development
SECRET_KEY=change-me-in-production
API_PORT=8000
WEB_PORT=3000

# ── Celery ──
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
