# ── Database ──
DATABASE_URL=postgresql+asyncpg://vibe:vibe@localhost:5432/vibeartifact
DATABASE_URL_SYNC=postgresql://vibe:vibe@localhost:5432/vibeartifact

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── LLM（至少配置一个 Provider 的 API Key）──
# DeepSeek（推荐，默认使用）
DEEPSEEK_API_KEY=sk-xxx
# 智谱 GLM
# GLM_API_KEY=xxx
# 通义千问（阿里 DashScope）
# DASHSCOPE_API_KEY=xxx
# 海外模型（可选）
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx

# ── 模型配置（LiteLLM 格式：provider/model-name）──
# DeepSeek 系列
REASONING_MODEL=deepseek/deepseek-reasoner
GENERATION_MODEL=deepseek/deepseek-chat
# 智谱 GLM 系列: zai/glm-4, zai/glm-4.5
# 通义千问系列: dashscope/qwen-max, dashscope/qwen-plus
# Anthropic 系列: anthropic/claude-sonnet-4-20250514
# OpenAI 系列: openai/gpt-4o

# ── 搜索 ──
SERPAPI_API_KEY=your-serpapi-key-here

# ── App ──
APP_ENV=development
SECRET_KEY=change-me-in-production
API_PORT=8000
WEB_PORT=3000

# ── Encryption ──
# 用于加密用户 API Key（Fernet 密钥，python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"）
ENCRYPTION_KEY=change-me-generate-with-fernet-generate-key

# ── Celery ──
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
